{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-stripper-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "ENVIRONMENT": "development",
    "ALLOWED_ORIGINS": ""
  }
}
